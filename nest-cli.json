      "sourceRoot": "apps/ms-reportes/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-reportes/tsconfig.app.json"
      }
    },
    "muro-escolar": {
      "type": "application",
      "root": "apps/muro-escolar",
      "entryFile": "main",
      "sourceRoot": "apps/muro-escolar/src",
